{
  "name": "mc-auto-player",
  "productName": "MC自动玩家",
  "version": "0.1.1",
  "description": "Minecraft Java 版自动玩家：多假人 + AI 对话/操控（Mineflayer 核心，命令行/WebUI/Electron 三种形态）",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "webui": "node web/server.js --port 8686 --open",
    "pack": "electron-builder --win",
    "dist": "node build/package.js",
    "test:e2e": "node test/e2e.js",
    "test:ai": "node test/ai-multi-check.js",
    "test:webui": "node test/webui-check.js",
    "test:cli": "node test/cli-check.js",
    "test:dist": "node test/dist-verify.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postject": "1.0.0-alpha.6"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-tool": "^1.2.0",
    "vec3": "^0.2.0"
  }
}
